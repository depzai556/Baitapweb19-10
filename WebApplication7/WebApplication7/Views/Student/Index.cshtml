@{
    ViewData["Title"] = "Student List";
  
    Layout = "~/Views/Shared/_Layout.cshtml";

}
@model IEnumerable<Student>
<a asp-controller="Student" asp-action="Create" class="btn btn-primary">Create Student</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Ảnh</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Điểm</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            string str = "";
            switch (s.Branch)
            {
                case Branch.IT: str = "CNTT"; break;
                case Branch.BE: str = "Kinh tế"; break;
                case Branch.CE: str = "Công trình"; break;
                case Branch.EE: str = "Điện - Điện tử"; break;
            }
            <tr>
                <td>@s.Id</td>
                <td>
                    @if (!string.IsNullOrEmpty(s.Image))
                    {
                        <img src="~/images/students/@s.Image" width="60" height="60" style="object-fit:cover" />
                    }
                </td>
                <td>@s.Name</td>
                <td>@s.DateOfBorth</td>
                <td>@str</td>
                <td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>@s.Email</td>
                <td>@s.Score</td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        var table = document.querySelector("table");
        table.onclick = function onTableClick() {
            table.style = "background-color: yellow;"
        }
    </script>
}