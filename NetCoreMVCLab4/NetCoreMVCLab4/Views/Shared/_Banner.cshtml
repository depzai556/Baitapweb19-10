<!-- Banner -->
<div id="myCarousel"
     class="carousel slide"
     data-ride="carousel"
     data-interval="6000">

    <!-- Các dấu chấm bên dưới Banner -->
    <ol class="carousel-indicators">

        <li data-target="#myCarousel"
            data-slide-to="0"
            class="active">
        </li>

        <li data-target="#myCarousel"
            data-slide-to="1">
        </li>

        <li data-target="#myCarousel"
            data-slide-to="2">
        </li>

    </ol>


    <!-- Nội dung Banner -->
    <div class="carousel-inner" role="listbox">

        <!-- Banner 1 -->
        <div class="item active">

            <img src="~/images/banner1.svg"
                 alt="ASP.NET"
                 class="img-responsive" />

            <div class="carousel-caption">

                <h1>ASP.NET Core</h1>

                <p>
                    Learn how to build ASP.NET apps
                    that can run anywhere.
                </p>

                <p>
                    <a class="btn btn-default"
                       href="#">
                        Learn More
                    </a>
                </p>

            </div>

        </div>


        <!-- Banner 2 -->
        <div class="item">

            <img src="~/images/banner3.svg"
                 alt="Windows"
                 class="img-responsive" />

            <div class="carousel-caption">

                <h1>Windows</h1>

                <p>
                    Build powerful applications.
                </p>

            </div>

        </div>


        <!-- Banner 3 -->
        <div class="item">

            <img src="~/images/banner3.svg"
                 alt="Linux"
                 class="img-responsive" />

            <div class="carousel-caption">

                <h1>Linux</h1>

                <p>
                    Run your application everywhere.
                </p>

            </div>

        </div>

    </div>


    <!-- Nút sang trái -->
    <a class="left carousel-control"
       href="#myCarousel"
       role="button"
       data-slide="prev">

        <span class="glyphicon glyphicon-chevron-left"
              aria-hidden="true">
        </span>

        <span class="sr-only">
            Previous
        </span>

    </a>


    <!-- Nút sang phải -->
    <a class="right carousel-control"
       href="#myCarousel"
       role="button"
       data-slide="next">

        <span class="glyphicon glyphicon-chevron-right"
              aria-hidden="true">
        </span>

        <span class="sr-only">
            Next
        </span>

    </a>

</div>