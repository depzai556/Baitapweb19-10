    <div class="container-fluid">

        <div class="navbar-header">
            <a class="navbar-brand" href="#">NetCoreMVCLab03</a>
        </div>

        <ul class="nav navbar-nav">
            <li class="active">
                <a href="#">Home</a>
            </li>

            <li>
                <a href="#">About</a>
            </li>

            <li>
                <a href="#">Contact</a>
            </li>

            <li>
                <a href="#">Books</a>
