        </ul>

    </div>
</nav>


<!-- Gọi Partial View Banner -->
<partial name="_Banner" />
<h2>Popular Book Load từ BookComponent</h2>

@await Component.InvokeAsync("Book")
<!-- Nút bấm -->
<button id="loadAjax"
        class="btn btn-sm btn-primary">
    Click load book từ PartialResult
</button>

<!-- Nơi nhận dữ liệu từ AJAX -->
<div id="data-from-ajax" class="row">
    Loading data.....
</div>


<!-- Nội dung bên dưới Banner -->
<div class="container">

    <div class="row">

        <!-- Application uses -->
        <div class="col-md-3">
            <h3>Application uses</h3>

            <ul>
                <li>Sample pages using ASP.NET Core MVC</li>
                <li>Theming using <a href="#">Bootstrap</a></li>
            </ul>
        </div>


        <!-- How to -->
        <div class="col-md-3">
            <h3>How to</h3>

            <ul>
                <li>
                    <a href="#">Add a Controller and View</a>
                </li>

                <li>
                    <a href="#">Manage User Secrets using Manage User Secrets</a>
                </li>

                <li>
                    <a href="#">Use logging to a new message</a>
                </li>

                <li>
                    <a href="#">Add packages using NuGet</a>
                </li>

                <li>
                    <a href="#">
                        Target development, staging or production environment
                    </a>
                </li>
            </ul>
        </div>


        <!-- Overview -->
        <div class="col-md-3">
            <h3>Overview</h3>

            <ul>
                <li>
                    <a href="#">
                        Conceptual overview of what is ASP.NET Core
                    </a>
                </li>

                <li>
                    <a href="#">
                        Fundamentals of ASP.NET Core such as Startup and middleware
                    </a>
                </li>

                <li>
                    <a href="#">Working with Data</a>
                </li>

                <li>
                    <a href="#">Security</a>
                </li>

                <li>
                    <a href="#">Client side development</a>
                </li>

                <li>
                    <a href="#">Develop on different platforms</a>
                </li>

                <li>
                    <a href="#">
                        Read more on the documentation site
                    </a>
                </li>
            </ul>
        </div>


        <!-- Run & Deploy -->
        <div class="col-md-3">
            <h3>Run &amp; Deploy</h3>

            <ul>
                <li>
                    <a href="#">Run your app</a>
                </li>

                <li>
                    <a href="#">
                        Run tools such as EF migrations and more
                    </a>
                </li>

                <li>
                    <a href="#">
                        Publish to Microsoft Azure Web Apps
                    </a>
                </li>
            </ul>
        </div>

    </div>

</div>
@section Scripts
{
    <script>

        $("#loadAjax").click(function () {

            $("#data-from-ajax").load("/Book/PopularBook");

        });

    </script>
}