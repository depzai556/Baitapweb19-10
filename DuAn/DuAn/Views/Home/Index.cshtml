@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Banner Microsoft Azure -->
<div class="p-5 mb-4 text-white text-center rounded-3" style="background-color: #2b4982;">
    <div class="container-fluid py-3">
        <h1 class="display-4 fw-normal">Microsoft Azure</h1>
        <p class="fs-6 mt-4">
            Learn how Microsoft's Azure cloud platform allows you to build, deploy, and scale web apps.
            <a href="#" class="btn btn-light btn-sm text-dark align-baseline">Learn More</a>
        </p>
    </div>
</div>

<!-- Danh sách sản phẩm dạng ô Card -->
